<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_12"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:paddingBottom="23dp"
        android:paddingLeft="34dp"
        android:paddingRight="34dp"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp" >

        <TextView
            android:textSize="18dp"
            android:textColor="@color/black"
            android:text="终端清点"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_marginLeft="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <ImageView
                android:background="@mipmap/ic_alarm"
                android:layout_width="27dp"
                android:layout_height="27dp" />

            <TextView
                android:layout_marginLeft="12dp"
                android:textSize="14dp"
                android:textColor="#4F627D"
                android:text="今日剩余次数："
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/terminal_remaining_number"
                android:textSize="14dp"
                android:textColor="@color/black"
                android:text="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />


        </LinearLayout>

        <LinearLayout
            android:layout_marginLeft="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <ImageView
                android:background="@mipmap/ic_time"
                android:layout_width="27dp"
                android:layout_height="27dp" />

            <TextView
                android:layout_marginLeft="16dp"
                android:textSize="14dp"
                android:textColor="#4F627D"
                android:text="清点时间："
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/terminal_clear_time"
                android:textSize="14dp"
                android:textColor="@color/black"
                android:text=""
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />


        </LinearLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent" >

            <TextView
                android:id="@+id/btn_export_excel"
                android:layout_toLeftOf="@+id/add_terminal"
                android:paddingLeft="17dp"
                android:paddingRight="17dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_4"
                android:layout_marginRight="10dp"
                android:layout_centerVertical="true"
                android:text="导出"
                android:textColor="#383B40"
                android:textSize="14dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/add_terminal"
                android:paddingLeft="17dp"
                android:paddingRight="17dp"
                android:gravity="center"
                android:background="@drawable/bg_btn2_4"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:text="开始清点"
                android:textColor="@color/white"
                android:textSize="14dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <!-- 两个饼状图的容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="horizontal"
            android:gravity="center" >


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.lora.cn.ui.view.PieChartView
                    android:id="@+id/pie_chart_online"
                    android:layout_centerInParent="true"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    app:radius="50dp"
                    app:backgroundRadius="57.5dp"
                    app:showLines="true"
                    app:ringWidth="30dp"
                    app:lineColor="#D8D8D8"
                    app:backgroundColor="#F1F4F8"
                    app:textSize="14sp"
                    app:textColor="#000000"
                    app:dotRadius="4dp"
                    app:gapAngle="5" />

                <TextView
                    android:text="丢失状态"
                    android:layout_centerInParent="true"
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.lora.cn.ui.view.PieChartView
                    android:id="@+id/pie_chart_battery"
                    android:layout_centerInParent="true"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    app:radius="50dp"
                    app:backgroundRadius="57.5dp"
                    app:showLines="true"
                    app:ringWidth="30dp"
                    app:lineColor="#D8D8D8"
                    app:backgroundColor="#F1F4F8"
                    app:textSize="14sp"
                    app:textColor="#000000"
                    app:dotRadius="4dp"
                    app:gapAngle="5" />

                <TextView
                    android:text="电量状态"
                    android:layout_centerInParent="true"
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </RelativeLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/terminal_check_recycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
