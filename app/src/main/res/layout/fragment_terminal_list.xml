<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:background="@drawable/bg_white_12"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:paddingLeft="24dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_height="0dp" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="2dp"
            android:paddingRight="2dp" >

            <TextView
                android:textSize="14dp"
                android:textColor="@color/black"
                android:text="分组："
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_group_category"
                android:background="@drawable/spinner_background"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:text="全部分组/全部分类" />


            <TextView
                android:layout_marginLeft="15dp"
                android:textSize="14dp"
                android:textColor="@color/black"
                android:text="筛选："
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:background="@drawable/spinner_background"
                android:layout_width="100dp"
                android:layout_height="40dp" >

                <Spinner
                    android:id="@+id/spinner_filter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:entries="@array/filter_options"
                    />

            </LinearLayout>


            <LinearLayout
                android:layout_marginLeft="15dp"
                android:layout_width="140dp"
                android:background="@drawable/spinner_background"
                android:orientation="horizontal"
                android:layout_height="40dp">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:hint="终端名称搜索"
                    android:padding="8dp"
                    android:textSize="12sp"
                    android:textColorHint="#838383"
                    android:textColor="@color/black"
                    android:drawableRight="@mipmap/ic_search"
                    android:drawablePadding="10dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_marginLeft="20dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" >

                <ImageView
                    android:id="@+id/sx_left"
                    android:background="@mipmap/ic_sx_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Spinner
                    android:id="@+id/spinner_ts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:entries="@array/page_size_options"
                    android:background="@drawable/spinner_no_arrow_background"
                    />

                <ImageView
                    android:id="@+id/sx_right"
                    android:background="@mipmap/ic_sx_rg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>


            <RelativeLayout
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp">

                <TextView
                    android:id="@+id/add_terminal"
                    android:paddingLeft="17dp"
                    android:paddingRight="17dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_4"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:text="添加终端"
                    android:textColor="#383B40"
                    android:textSize="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp" />

</RelativeLayout>

    <!-- 右下角报警浮层 -->
    <RelativeLayout
        android:id="@+id/ll_alert_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@drawable/bg_white_12"
            android:layout_alignParentRight="true"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_alert_text"
                android:text="设备丢失"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"/>

            <TextView
                android:id="@+id/btn_alert_mute"
                android:text="静音"
                android:background="@drawable/bg_btn_4"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"/>

            <TextView
                android:id="@+id/btn_alert_minimize"
                android:text="最小化"
                android:background="@drawable/bg_btn_4"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"/>

            <TextView
                android:id="@+id/btn_alert_handle"
                android:text="立即处理"
                android:background="@drawable/bg_btn_4"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" >


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/terminal_recycle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- 待处理入口（浮标） -->
            <RelativeLayout
                android:id="@+id/ll_alert_pending"
                android:visibility="gone"
                android:background="#4C000000"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_width="396dp"
                android:layout_height="266dp">


                <LinearLayout
                    android:layout_centerInParent="true"
                    android:background="#F0F0F0"
                    android:layout_width="364dp"
                    android:gravity="center"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="20dp"
                    android:paddingTop="20dp"
                    android:orientation="vertical"
                    android:layout_height="220dp" >

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" >

                            <TextView
                                android:id="@+id/error_title"
                                android:textColor="#B1060F"
                                android:textSize="20dp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <View
                                android:id="@+id/error_line"
                                android:background="#B1060F"
                                android:layout_width="94dp"
                                android:layout_height="4dp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="right|center"
                            android:layout_height="wrap_content" >

                            <ImageView
                                android:id="@+id/error_small"
                                android:background="@mipmap/ic_sx_s"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />

                            <ImageView
                                android:id="@+id/error_close"
                                android:layout_marginLeft="25dp"
                                android:background="@mipmap/ic_ss_close"
                                android:layout_width="18dp"
                                android:layout_height="18dp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="0dp" >

                        <TextView
                            android:id="@+id/error_name"
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" >

                            <TextView
                                android:id="@+id/error_code"
                                android:textSize="14dp"
                                android:textColor="@color/black"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/error_time"
                                android:textSize="14dp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>
                        
                    </LinearLayout>

                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="34dp" >

                        <TextView
                            android:id="@+id/error_voice_no"
                            android:text="静音"
                            android:background="@drawable/bg_btn_voice"
                            android:gravity="center"
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:layout_width="125dp"
                            android:layout_height="34dp" />

                        <View
                            android:layout_width="35dp"
                            android:layout_height="35dp" />
                        <TextView
                            android:id="@+id/error_complte"
                            android:text="立即处理"
                            android:background="@drawable/bg_btn_now"
                            android:gravity="center"
                            android:textSize="16dp"
                            android:textColor="@color/white"
                            android:layout_width="125dp"
                            android:layout_height="34dp" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/ll_alert_pending_small"
                android:visibility="visible"
                android:background="@color/white"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_width="75dp"
                android:layout_height="75dp">


                <RelativeLayout
                    android:background="@drawable/bg_btn_round"
                    android:layout_centerInParent="true"
                    android:layout_width="71dp"
                    android:layout_height="71dp" >

                    <ImageView
                        android:layout_centerInParent="true"
                        android:background="@mipmap/ic_error_num"
                        android:layout_width="30dp"
                        android:layout_height="30dp"/>

                </RelativeLayout>

                <RelativeLayout
                    android:background="@drawable/bg_btn_round_red"
                    android:layout_alignParentTop="true"
                    android:layout_width="28dp"
                    android:layout_alignParentRight="true"
                    android:layout_height="28dp" >

                    <TextView
                        android:id="@+id/error_number"
                        android:layout_centerInParent="true"
                        android:textSize="14dp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </RelativeLayout>

            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <RelativeLayout
        android:background="#F1F5F9"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="60dp" >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_terminal_status"
            android:visibility="visible"
            android:layout_centerInParent="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </RelativeLayout>

</LinearLayout>