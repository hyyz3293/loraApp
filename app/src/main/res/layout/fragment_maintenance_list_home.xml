<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <RelativeLayout
        android:visibility="gone"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:layout_width="match_parent"
        android:layout_height="93dp">

        <TextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:text="维护列表"
            android:layout_centerVertical="true"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </RelativeLayout>

    <View
        android:layout_marginRight="30dp"
        android:layout_marginLeft="30dp"
        android:background="#AEAEAE"
        android:layout_width="match_parent"
        android:layout_height="0.5dp" />

    <LinearLayout
        android:id="@+id/layout_maintenance_filter"
        android:layout_marginRight="30dp"
        android:layout_marginLeft="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:id="@+id/tv_filter_all"
            android:text="全部"
            android:gravity="center"
            android:textColor="#333333"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_voice"
            android:layout_marginRight="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tv_filter_pending"
            android:text="待维护"
            android:gravity="center"
            android:textColor="#333333"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_voice"
            android:layout_marginRight="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tv_filter_done"
            android:text="已维护"
            android:gravity="center"
            android:textColor="#333333"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_marginRight="30dp"
        android:layout_marginLeft="30dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <TextView
            android:text="时间"
            android:gravity="center_vertical"
            android:textColor="#333333"
            android:textSize="12dp"
            android:textStyle="bold"
            android:layout_weight="188"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

        <TextView
            android:text="状态"
            android:gravity="center_vertical"
            android:textColor="#333333"
            android:textSize="12dp"
            android:textStyle="bold"
            android:layout_weight="138"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="156"
            android:gravity="center_vertical"
            android:text="终端"
            android:textColor="#333333"
            android:textSize="12dp"
            android:textStyle="bold" />

        <TextView
            android:text="终端ID"
            android:gravity="center_vertical"
            android:textColor="#333333"
            android:textSize="12dp"
            android:textStyle="bold"
            android:layout_weight="168"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

        <TextView
            android:text="维护内容"
            android:visibility="visible"
            android:gravity="center_vertical"
            android:textColor="#333333"
            android:textSize="12dp"
            android:textStyle="bold"
            android:layout_weight="168"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

        <TextView
            android:text="维护时间"
            android:gravity="center_vertical"
            android:textColor="#333333"
            android:textSize="12dp"
            android:textStyle="bold"
            android:layout_weight="182"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

        <TextView
            android:text="操作"
            android:gravity="center_vertical"
            android:textColor="#333333"
            android:textSize="12dp"
            android:textStyle="bold"
            android:layout_weight="107"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

    </LinearLayout>

    <View
        android:layout_marginRight="30dp"
        android:layout_marginLeft="30dp"
        android:background="#AEAEAE"
        android:layout_width="match_parent"
        android:layout_height="0.5dp" />

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/swipe_maintenance"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.scwang.smart.refresh.header.ClassicsHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_maintenance"
            android:layout_marginRight="30dp"
            android:layout_marginLeft="30dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

</LinearLayout>
