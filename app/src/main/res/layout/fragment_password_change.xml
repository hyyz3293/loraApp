<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <!-- 原密码 -->
    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="43dp"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="原密码："
            android:textSize="16dp"
            android:textColor="#1D2129"
            android:textStyle="bold"
            android:gravity="center|right" />

        <EditText
            android:id="@+id/et_old_password"
            android:paddingLeft="28dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:hint="请输入原密码"
            android:textSize="16dp"
            android:textColor="#1D2129"
            android:textStyle="bold"
            android:background="@drawable/edit_text_background"
            android:layout_marginStart="8dp"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/iv_toggle_old_password"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_view" />

    </LinearLayout>

    <!-- 新密码 -->
    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="43dp"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="新密码："
            android:textSize="16dp"
            android:textColor="#1D2129"
            android:textStyle="bold"
            android:gravity="center|right" />

        <EditText
            android:id="@+id/et_new_password"
            android:paddingLeft="28dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:hint="请输入新密码"
            android:textSize="16dp"
            android:textColor="#1D2129"
            android:textStyle="bold"
            android:background="@drawable/edit_text_background"
            android:layout_marginStart="8dp"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/iv_toggle_new_password"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_view" />

    </LinearLayout>

    <!-- 确认密码 -->
    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="43dp"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="确认密码："
            android:textSize="16dp"
            android:textColor="#1D2129"
            android:textStyle="bold"
            android:gravity="center|right" />

        <EditText
            android:id="@+id/et_confirm_password"
            android:paddingLeft="28dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:hint="请输入确认密码"
            android:textSize="16dp"
            android:textColor="#1D2129"
            android:textStyle="bold"
            android:background="@drawable/edit_text_background"
            android:layout_marginStart="8dp"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/iv_toggle_confirm_password"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_view" />

    </LinearLayout>

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="64dp">

        <TextView
            android:id="@+id/btn_cancel_password"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="取消"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:background="@drawable/button_cancel_background"
            android:layout_marginEnd="24dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_save_password"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="确定"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/button_primary_background"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
