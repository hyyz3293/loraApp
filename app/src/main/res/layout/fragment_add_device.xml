<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- 标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text=""
            android:textSize="30dp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:padding="8dp"
            android:text="设置终端"
            android:textSize="30dp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/btn_save"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_back_4"
            android:textSize="16dp"
            android:gravity="center"
            android:textColor="#383B40"
            android:text="返回"
            android:textStyle="bold"
            android:layout_width="98dp"
            android:layout_height="32dp" />

    </RelativeLayout>

    <!-- 内容区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- 终端ID显示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_weight="380"
                    android:gravity="right|center_vertical"
                    android:layout_height="match_parent" >

                    <ImageView
                        android:layout_width="4dp"
                        android:layout_height="10dp"
                        android:layout_marginRight="15dp"
                        android:background="@drawable/bg_add_device"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="终端ID"
                        android:layout_marginRight="10dp"
                        android:gravity="right|center"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <TextView
                    android:id="@+id/tv_terminal_id"
                    android:paddingLeft="28dp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="500"
                    android:layout_height="match_parent"
                    android:text="000010"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView

                    android:layout_width="0dp"
                    android:layout_weight="300"
                    android:layout_height="match_parent"
                    />

            </LinearLayout>

            <!-- 设备Code和设备名称横向输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                >

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_weight="380"
                    android:gravity="right|center_vertical"
                    android:layout_height="match_parent" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="*"
                        android:layout_marginRight="3dp"
                        android:gravity="right|center"
                        android:textColor="#E40000"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="终端编号"
                        android:layout_marginRight="10dp"
                        android:gravity="right|center"
                        android:textColor="#000000"
                        android:textSize="16sp"
                          />

                </LinearLayout>

                <EditText
                    android:id="@+id/et_device_id"
                    android:paddingLeft="28dp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="500"
                    android:layout_height="match_parent"
                    android:hint="请输入设备Code"
                    android:inputType="text"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="300"
                    android:layout_height="match_parent"
                    />

            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:background="#FFffff"
                android:orientation="horizontal"
                >




                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_weight="380"
                    android:gravity="right|center_vertical"
                    android:layout_height="match_parent" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="*"
                        android:layout_marginRight="3dp"
                        android:gravity="right|center"
                        android:textColor="#E40000"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="设备名称"
                        android:layout_marginRight="10dp"
                        android:gravity="right|center"
                        android:textColor="#000000"
                        android:textSize="16sp"
                          />

                </LinearLayout>
                <EditText
                    android:id="@+id/et_device_name"
                    android:paddingLeft="28dp"
                    android:background="@drawable/edit_text_background"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="500"
                    android:layout_height="match_parent"
                    android:hint="请输入设备名称"
                    android:inputType="text"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="300"
                    android:layout_height="match_parent"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_weight="380"
                    android:gravity="right|center_vertical"
                    android:layout_height="match_parent" >

                    <ImageView
                        android:layout_width="4dp"
                        android:layout_height="10dp"
                        android:layout_marginRight="15dp"
                        android:background="@drawable/bg_add_device"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="分组"
                        android:layout_marginRight="10dp"
                        android:gravity="right|center"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <TextView

                    android:paddingLeft="28dp"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="500"
                    android:layout_height="match_parent"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView

                    android:layout_width="0dp"
                    android:layout_weight="300"
                    android:layout_height="match_parent"
                    />

            </LinearLayout>

            <!-- 动态分组-分类RecyclerView（根据数据库中的分组数量动态渲染行） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dynamic_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="取消"
            android:textColor="#383B40"
            android:textSize="16sp"
            android:background="@drawable/bg_back_4" />

        <TextView
            android:id="@+id/btn_confirm_pair"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:text="完成配对"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:background="@drawable/bg_btn2_4" />
    </LinearLayout>

</LinearLayout>
