<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@mipmap/app_login"
    tools:context=".ui.activity.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@mipmap/app_login"
        tools:context=".ui.activity.MainActivity">

        <!-- 顶部导航栏 -->
        <LinearLayout
            android:id="@+id/top_navigation"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <!-- Logo和标题区域 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@mipmap/app_logo"
                    android:layout_marginRight="15dp" />

                <TextView
                    android:layout_marginLeft="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="终端监控中心"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 中间菜单区域 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_menu_tabs"
                android:layout_marginLeft="25dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- 右侧用户信息区域 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <ImageView
                    android:id="@+id/iv_user_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_user"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前用户"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginRight="15dp" />

                <View
                    android:background="#8291A9"
                    android:layout_width="1dp"
                    android:layout_height="20dp" />

                <ImageView
                    android:id="@+id/logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_logout"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="28dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 用户信息Fragment容器 -->
        <FrameLayout
            android:id="@+id/fragment_user_info_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- 设备信息Fragment容器 -->
        <FrameLayout
            android:id="@+id/fragment_device_list_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- ViewPager2容器 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- 全局报警窗口层 -->
    <RelativeLayout
        android:id="@+id/global_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false">

        <!-- 全局：待处理入口（大浮层） -->
        <RelativeLayout
            android:id="@+id/ll_alert_pending"
            android:visibility="gone"
            android:background="#4C000000"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_width="396dp"
            android:layout_height="266dp">

            <LinearLayout
                android:layout_centerInParent="true"
                android:background="#F0F0F0"
                android:layout_width="364dp"
                android:gravity="center"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp"
                android:paddingTop="20dp"
                android:orientation="vertical"
                android:layout_height="220dp" >

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" >

                        <TextView
                            android:id="@+id/error_title"
                            android:textColor="#B1060F"
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <View
                            android:id="@+id/error_line"
                            android:background="#B1060F"
                            android:layout_width="94dp"
                            android:layout_height="4dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="right|center"
                        android:layout_height="wrap_content" >

                        <ImageView
                            android:id="@+id/error_small"
                            android:background="@mipmap/ic_sx_s"
                            android:layout_width="18dp"
                            android:layout_height="18dp" />

                        <ImageView
                            android:id="@+id/error_close"
                            android:layout_marginLeft="25dp"
                            android:background="@mipmap/ic_ss_close"
                            android:layout_width="18dp"
                            android:layout_height="18dp"/>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="0dp" >

                    <TextView
                        android:id="@+id/error_name"
                        android:textSize="16dp"
                        android:textColor="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <TextView
                            android:id="@+id/error_code"
                            android:textSize="14dp"
                            android:textColor="@color/black"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/error_time"
                            android:textSize="14dp"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="34dp" >

                    <TextView
                        android:id="@+id/error_voice_no"
                        android:text="静音"
                        android:background="@drawable/bg_btn_voice"
                        android:gravity="center"
                        android:textSize="16dp"
                        android:textColor="@color/black"
                        android:layout_width="125dp"
                        android:layout_height="34dp" />

                    <View
                        android:layout_width="35dp"
                        android:layout_height="35dp" />
                    <TextView
                        android:id="@+id/error_complte"
                        android:text="确认处理"
                        android:background="@drawable/bg_btn_now"
                        android:gravity="center"
                        android:textSize="16dp"
                        android:textColor="@color/white"
                        android:layout_width="125dp"
                        android:layout_height="34dp" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <!-- 全局：右下角小浮标 -->
        <RelativeLayout
            android:id="@+id/ll_alert_pending_small"
            android:visibility="gone"
            android:layout_margin="30dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_width="75dp"
            android:layout_height="75dp">

            <RelativeLayout
                android:background="@drawable/bg_btn_round"
                android:layout_centerInParent="true"
                android:layout_width="71dp"
                android:layout_height="71dp" >

                <ImageView
                    android:layout_centerInParent="true"
                    android:background="@mipmap/ic_error_num"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>

                <ImageView
                    android:id="@+id/error_muted_mark"
                    android:visibility="gone"
                    android:layout_centerInParent="true"
                    android:rotation="45"
                    android:background="@drawable/ic_close_small"
                    android:layout_width="26dp"
                    android:layout_height="26dp"/>

            </RelativeLayout>

            <RelativeLayout
                android:background="@drawable/bg_btn_round_red"
                android:layout_alignParentTop="true"
                android:layout_width="28dp"
                android:layout_alignParentRight="true"
                android:layout_height="28dp" >

                <TextView
                    android:id="@+id/error_number"
                    android:layout_centerInParent="true"
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>
