<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Battery body -->
    <item android:left="6dp" android:top="8dp" android:right="6dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFC107"/>
            <stroke android:width="1dp" android:color="#F57C00"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <!-- Battery head -->
    <item android:left="18dp" android:top="10dp" android:right="4dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFC107"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <!-- Battery fill -->
    <item android:left="8dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFD54F"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>